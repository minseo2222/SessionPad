<Window x:Class="SessionPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SessionPad.App.Views"
        mc:Ignorable="d"
        Title="SessionPad"
        Width="380"
        Height="560"
        MinWidth="320"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource Surface.Base}">
    <Grid Background="{DynamicResource Surface.Base}">
        <views:DockedTabView HorizontalAlignment="Center"
                             VerticalAlignment="Center">
            <views:DockedTabView.Style>
                <Style TargetType="{x:Type views:DockedTabView}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDockedTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:DockedTabView.Style>
        </views:DockedTabView>

        <views:CompactNoteView HorizontalAlignment="Center"
                               VerticalAlignment="Center">
            <views:CompactNoteView.Style>
                <Style TargetType="{x:Type views:CompactNoteView}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompactNote}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:CompactNoteView.Style>
        </views:CompactNoteView>
    </Grid>
</Window>
