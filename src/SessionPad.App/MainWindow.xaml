<Window x:Class="SessionPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SessionPad.App.Views"
        mc:Ignorable="d"
        Title="SessionPad"
        Width="380"
        Height="560"
        MinWidth="320"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        WindowStyle="None"
        Background="{DynamicResource Surface.Base}">
    <WindowChrome.WindowChrome>
        <!-- Chromeless shell: no caption bar, edge resize kept, thin glass frame so the
             DWM drop shadow is preserved. Corners are rounded natively via
             DWMWA_WINDOW_CORNER_PREFERENCE on Windows 11 (square fallback elsewhere). -->
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource Surface.Base}">
        <views:DockedTabView HorizontalAlignment="Center"
                             VerticalAlignment="Center">
            <views:DockedTabView.Style>
                <Style TargetType="{x:Type views:DockedTabView}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDockedTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:DockedTabView.Style>
        </views:DockedTabView>

        <views:CompactNoteView HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch">
            <views:CompactNoteView.Style>
                <Style TargetType="{x:Type views:CompactNoteView}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompactNote}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:CompactNoteView.Style>
        </views:CompactNoteView>
    </Grid>
</Window>
