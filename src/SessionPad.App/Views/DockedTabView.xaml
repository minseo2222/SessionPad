<UserControl x:Class="SessionPad.App.Views.DockedTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="96"
             d:DesignWidth="64">
    <Border Width="64"
            Height="96"
            Padding="8"
            Background="#20242A"
            BorderBrush="#3D4652"
            BorderThickness="1"
            CornerRadius="6">
        <Button Command="{Binding ExpandCommand}"
                Cursor="Hand"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="SP"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#F5F7FA"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding TodoCount}"
                           Margin="0,8,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#9AD0FF"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Open"
                           Margin="0,8,0,0"
                           FontSize="10"
                           Foreground="#C7D0DA"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>
    </Border>
</UserControl>
