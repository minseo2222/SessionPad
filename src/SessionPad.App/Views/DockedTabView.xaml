<UserControl x:Class="SessionPad.App.Views.DockedTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="116"
             d:DesignWidth="84">
    <Border Width="84"
            Height="116"
            Padding="8"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Hairline}"
            BorderThickness="1"
            CornerRadius="8"
            AutomationProperties.Name="SessionPad docked tab. Drag to move."
            MouseLeftButtonDown="OnTabMoveMouseLeftButtonDown">
        <Button Command="{Binding ExpandCommand}"
                Cursor="Hand"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                AutomationProperties.Name="Expand SessionPad">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="SP"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="SessionPad"
                           Margin="0,4,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource Text.Muted}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding OpenTodoCount, StringFormat={}TODO {0}}"
                           Margin="0,7,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CurrentSessionKind}"
                           Margin="0,5,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource Text.Muted}"
                           MaxWidth="64"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Expand"
                           Margin="0,5,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource Text.Primary}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>
    </Border>
</UserControl>
