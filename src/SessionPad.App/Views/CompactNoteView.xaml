<UserControl x:Class="SessionPad.App.Views.CompactNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="340">
    <UserControl.Resources>
        <Style x:Key="ItemActionButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.78" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteItemActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ItemActionButtonStyle}">
            <Setter Property="AutomationProperties.Name" Value="Delete" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
                    <Setter Property="Foreground" Value="#C0453F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReorderButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ItemActionButtonStyle}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style x:Key="EmptyStateTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="20,12" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Surface.Base}"
            BorderBrush="{DynamicResource Border.Hairline}"
            BorderThickness="1"
            CornerRadius="11">
        <!-- No DropShadowEffect: the chromeless window's DWM frame provides the shadow
             (and, on Windows 11, the rounded corners). -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Spine.Neutral}">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{DynamicResource Spine.Neutral}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentSessionNamed}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrentSessionPinned}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Grid Grid.Column="1"
                  Margin="11,11,13,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,12"
                      Background="Transparent"
                      MouseLeftButtonDown="OnHeaderMoveMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="0,2"
                            Cursor="SizeAll"
                            ToolTip="Drag near a window to attach"
                            AutomationProperties.Name="Drag to attach to a window"
                            MouseLeftButtonDown="OnDragAttachMouseLeftButtonDown">
                        <TextBlock Text="Drag"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text.Faint}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Margin="8,0,8,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left">
                        <Border x:Name="SessionIdentityFlash"
                                Background="{DynamicResource Accent}"
                                CornerRadius="5"
                                Margin="-6,-2"
                                Opacity="0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="●"
                                       FontSize="8"
                                       VerticalAlignment="Center"
                                       Margin="0,1,6,0"
                                       Foreground="{DynamicResource Status.Success}"
                                       ToolTip="Attached to the target window">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAttachedToWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.Target="{Binding ElementName=SessionIdentityFlash}"
                                                                                           Storyboard.TargetProperty="Opacity">
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.22" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentSessionDisplayName}"
                                       ToolTip="{Binding CurrentSessionDisplayName}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Text.Primary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Column="3"
                               Text="●"
                               FontSize="14"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentSessionPinned}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="4"
                            Command="{Binding ToggleSettingsCommand}"
                            Content="&#x2699;"
                            Width="25"
                            Height="25"
                            Padding="0"
                            Foreground="{DynamicResource Text.Faint}"
                            ToolTip="Settings"
                            AutomationProperties.Name="Settings" />
                    <Button Grid.Column="5"
                            Command="{Binding CollapseCommand}"
                            Content="&#x2212;"
                            Width="25"
                            Height="25"
                            Padding="0"
                            Margin="5,0,0,0"
                            Foreground="{DynamicResource Text.Faint}"
                            ToolTip="Collapse to tab"
                            AutomationProperties.Name="Collapse to tab" />
                    <Button Grid.Column="6"
                            Click="OnCloseButtonClick"
                            Content="&#x2715;"
                            Width="25"
                            Height="25"
                            Padding="0"
                            Margin="5,0,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource Text.Faint}"
                            ToolTip="Hide to tray"
                            AutomationProperties.Name="Hide to tray" />
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,0,0,12"
                        BorderBrush="{DynamicResource Border.Hairline}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Button Content="Key"
                                    Command="{Binding SelectNoteTabCommand}"
                                    CommandParameter="Key"
                                    Padding="7,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyTabActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Grid.Row="1" Background="{DynamicResource Accent}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Button Content="Todo"
                                    Command="{Binding SelectNoteTabCommand}"
                                    CommandParameter="Todo"
                                    Padding="7,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTodoTabActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Grid.Row="1" Background="{DynamicResource Accent}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTodoTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Button Content="Commands"
                                    Command="{Binding SelectNoteTabCommand}"
                                    CommandParameter="Commands"
                                    Padding="7,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCommandsTabActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Grid.Row="1" Background="{DynamicResource Accent}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCommandsTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Button Content="Notes"
                                    Command="{Binding SelectNoteTabCommand}"
                                    CommandParameter="Notes"
                                    Padding="7,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNotesTabActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Grid.Row="1" Background="{DynamicResource Accent}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNotesTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      Margin="0,0,0,12">
                    <Border Background="{DynamicResource Surface.Capture}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3,5,3,11">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsKeyTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding AddPinnedCommand}"
                                    AutomationProperties.Name="Add key detail"
                                    Content="+"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource Accent}"
                                    FontSize="15"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewPinnedText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New key detail"
                                     Tag="Save a key detail…"
                                     MinHeight="36"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddPinnedCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2"
                                       Text="↵"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,6,0" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource Surface.Capture}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3,5,3,11">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsTodoTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding AddTodoCommand}"
                                    AutomationProperties.Name="Add to-do"
                                    Content="+"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource Accent}"
                                    FontSize="15"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New to-do"
                                     Tag="Capture a todo…"
                                     MinHeight="36"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddTodoCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2"
                                       Text="↵"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,6,0" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource Surface.Capture}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3,5,3,11">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsCommandsTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding AddCommandItemCommand}"
                                    AutomationProperties.Name="Add command"
                                    Content="&gt;"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource Accent}"
                                    FontSize="15"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewCommandText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New command"
                                     Tag="Add a command…"
                                     MinHeight="36"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddCommandItemCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2"
                                       Text="↵"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,6,0" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource Surface.Capture}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3,5,3,11">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsNotesTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding AddNoteCommand}"
                                    AutomationProperties.Name="Add note"
                                    Content="+"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource Accent}"
                                    FontSize="15"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New note"
                                     Tag="Write a note…"
                                     MinHeight="36"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddNoteCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2"
                                       Text="↵"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,6,0" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="SearchNotesLabel"
                                           Text="Search notes"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Text.Primary}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=SearchNotesLabel}"
                                             Tag="Search all sessions…"
                                             MinHeight="36"
                                             VerticalContentAlignment="Center">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Content="Search"
                                            Command="{Binding SearchCommand}"
                                            Padding="10,4"
                                            VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Margin="6,0,0,0"
                                            Content="Clear"
                                            Command="{Binding ClearSearchCommand}"
                                            Padding="8,4"
                                            VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Status}"
                                           TextWrapping="Wrap"
                                           Text="{Binding SearchStatus, Mode=OneWay}" />
                                <ItemsControl Margin="0,6,0,0"
                                              ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,0,5"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.JumpToSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource Surface.Raised}"
                                                    BorderBrush="{DynamicResource Border.Faint}"
                                                    BorderThickness="1"
                                                    Padding="9,7"
                                                    Cursor="Hand">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SessionName}"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Snippet}"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Text.Muted}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MatchSummary}"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Text.Faint}"
                                                               FontSize="10.5" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Margin="0,10,0,12"
                                        BorderBrush="{DynamicResource Border.Hairline}"
                                        BorderThickness="0,0,0,1" />

                                <TextBlock Text="This session"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Text.Primary}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewSessionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Rename this session"
                                             Tag="Rename this session…"
                                             MinHeight="36"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Content="Rename Session"
                                            Command="{Binding RenameSessionCommand}"
                                            Padding="8,4"
                                            VerticalAlignment="Center" />
                                </Grid>
                                <CheckBox Margin="0,8,0,0"
                                          Content="Pin to this app (ignore window title)"
                                          IsChecked="{Binding IsCurrentSessionPinned, Mode=TwoWay}" />

                                <TextBlock Margin="0,14,0,0"
                                           Text="Sessions"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Text.Primary}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Text.Faint}"
                                           TextWrapping="Wrap"
                                           Text="No saved sessions yet. Attach SessionPad to a window to start one.">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer Margin="0,6,0,0"
                                              MaxHeight="190"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Sessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,5"
                                                        Padding="9,7"
                                                        Background="{DynamicResource Surface.Raised}"
                                                        BorderBrush="{DynamicResource Border.Faint}"
                                                        BorderThickness="1"
                                                        CornerRadius="7">
                                                    <Grid>
                                                        <Grid x:Name="SessionRowNormal">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center"
                                                                        Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#x25CF;"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource Accent}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,5,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="{x:Type TextBlock}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontWeight="Medium"
                                                                               Foreground="{DynamicResource Text.Primary}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Detail}"
                                                                           Margin="0,2,0,0"
                                                                           Foreground="{DynamicResource Text.Faint}"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Content="Open"
                                                                    Padding="8,3"
                                                                    FontSize="11"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Grid.Column="2"
                                                                    Content="Delete"
                                                                    Padding="8,3"
                                                                    FontSize="11"
                                                                    Margin="6,0,0,0"
                                                                    Foreground="#C0453F"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.RequestDeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                        <Grid x:Name="SessionRowConfirm"
                                                              Visibility="Collapsed">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Delete this session and its note?"
                                                                       Foreground="{DynamicResource Text.Primary}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0" />
                                                            <Button Grid.Column="1"
                                                                    Content="Delete"
                                                                    Padding="8,3"
                                                                    FontSize="11"
                                                                    Foreground="#C0453F"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.ConfirmDeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Grid.Column="2"
                                                                    Content="Cancel"
                                                                    Padding="8,3"
                                                                    FontSize="11"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.CancelDeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeleteConfirmPending}" Value="True">
                                                        <Setter TargetName="SessionRowNormal" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="SessionRowConfirm" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Margin="0,14,0,0"
                                           Text="Local Data"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Text.Primary}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Text="{Binding LocalDataPath, Mode=OneWay, FallbackValue=Storage path unavailable, StringFormat={}Path: {0}}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Text.Faint}"
                                           TextWrapping="Wrap"
                                           Text="Your notes are stored locally on this device only. No account, no cloud sync, no telemetry. SessionPad never reads your screen, terminal, or other apps." />
                                <DockPanel Margin="0,8,0,0">
                                    <DockPanel.Style>
                                        <Style TargetType="{x:Type DockPanel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeleteConfirmPending}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Button DockPanel.Dock="Left"
                                            Command="{Binding OpenLocalDataFolderCommand}"
                                            Content="Open Folder"
                                            MinWidth="88"
                                            Padding="8,4" />
                                    <Button DockPanel.Dock="Right"
                                            Command="{Binding DeleteLocalDataCommand}"
                                            Content="Delete All Local Data"
                                            MinWidth="132"
                                            Padding="8,4"
                                            Margin="8,0,0,0" />
                                </DockPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeleteConfirmPending}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Foreground="{DynamicResource Text.Primary}"
                                               TextWrapping="Wrap"
                                               Text="Delete all local SessionPad data? This cannot be undone." />
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0">
                                        <Button Command="{Binding ConfirmDeleteLocalDataCommand}"
                                                Content="Delete"
                                                Foreground="#C0453F"
                                                MinWidth="88"
                                                Padding="8,4" />
                                        <Button Command="{Binding CancelDeleteLocalDataCommand}"
                                                Content="Cancel"
                                                MinWidth="88"
                                                Padding="8,4"
                                                Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource Status}"
                                           TextWrapping="Wrap"
                                           Text="{Binding LocalDataStatus, Mode=OneWay, TargetNullValue=Ready, FallbackValue=Local data ready, StringFormat={}Status: {0}}" />

                                <CheckBox Margin="0,12,0,0"
                                          Content="Start with Windows"
                                          IsChecked="{Binding StartOnLogin, Mode=TwoWay}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Status}"
                                           TextWrapping="Wrap"
                                           Text="{Binding StartupStatus, Mode=OneWay, FallbackValue=Startup ready, StringFormat={}Startup: {0}}" />
                                <CheckBox Margin="0,8,0,0"
                                          Content="Dark theme"
                                          IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                                <CheckBox Margin="0,12,0,0"
                                          Content="Auto-track focused window"
                                          IsChecked="{Binding AutoTrackForeground, Mode=TwoWay}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Text.Faint}"
                                           TextWrapping="Wrap"
                                           Text="When on, SessionPad attaches to whichever window you focus and shows its note. Matching uses the window title only; nothing inside the window is read." />

                                <TextBlock x:Name="AttachShortcutLabel"
                                           Margin="0,14,0,0"
                                           Text="Attach shortcut"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Text.Primary}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding HotkeyOptions}"
                                              AutomationProperties.LabeledBy="{Binding ElementName=AttachShortcutLabel}"
                                              SelectedItem="{Binding SelectedHotkey, Mode=TwoWay}"
                                              DisplayMemberPath="Display"
                                              MinHeight="32"
                                              VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Content="Apply"
                                            Command="{Binding ApplyHotkeyCommand}"
                                            Padding="12,4"
                                            VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Status}"
                                           TextWrapping="Wrap"
                                           Text="{Binding HotkeyStatus, Mode=OneWay}" />

                                <Expander Margin="0,12,0,0"
                                          Foreground="{DynamicResource Text.Primary}">
                                    <Expander.Header>
                                        <TextBlock Text="Developer info"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Text.Primary}" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="Current Session"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Text.Primary}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentSessionDisplayName, Mode=OneWay, TargetNullValue=(none), FallbackValue=Name: (none), StringFormat={}Name: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding CurrentSessionKind, Mode=OneWay, TargetNullValue=(none), FallbackValue=Type: (none), StringFormat={}Type: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentSessionId, Mode=OneWay, TargetNullValue=(none), FallbackValue=Session ID: (none), StringFormat={}Session ID: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentNormalizedWindowTitle, Mode=OneWay, TargetNullValue=(none), FallbackValue=Normalized title: (none), StringFormat={}Normalized title: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentSessionMatchKey, Mode=OneWay, TargetNullValue=(none), FallbackValue=Match key: (none), StringFormat={}Match key: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentSessionNoteFile, Mode=OneWay, TargetNullValue=(none), FallbackValue=Note file: (none), StringFormat={}Note file: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Status}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentSessionStatus, Mode=OneWay, TargetNullValue=Ready, FallbackValue=Session status: Ready, StringFormat={}Session status: {0}}" />

                                        <!-- DetectedWindowInfo is read-only debug state. Use TextBlock or Mode=OneWay bindings only. -->
                                        <TextBlock Margin="0,12,0,0"
                                                   Text="Detected Window"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Text.Primary}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.ProcessName, Mode=OneWay, TargetNullValue=(none), FallbackValue=Process: (none), StringFormat={}Process: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LastDetectedWindow.Title, Mode=OneWay, TargetNullValue=(none), FallbackValue=Title: (none), StringFormat={}Title: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.HwndHex, Mode=OneWay, TargetNullValue=(none), FallbackValue=HWND: (none), StringFormat={}HWND: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.ProcessId, Mode=OneWay, TargetNullValue=(none), FallbackValue=Process ID: (none), StringFormat={}Process ID: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LastDetectedWindow.BoundsText, Mode=OneWay, TargetNullValue=(none), FallbackValue=Bounds: (none), StringFormat={}Bounds: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.IsMinimized, Mode=OneWay, TargetNullValue=(none), FallbackValue=Minimized: (none), StringFormat={}Minimized: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.IsVisible, Mode=OneWay, TargetNullValue=(none), FallbackValue=Visible: (none), StringFormat={}Visible: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.IsSessionPadWindow, Mode=OneWay, TargetNullValue=(none), FallbackValue=SessionPad window: (none), StringFormat={}SessionPad window: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.WindowClass, Mode=OneWay, TargetNullValue=(none), FallbackValue=Class: (none), StringFormat={}Class: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Status}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LastDetectedWindow.Error, Mode=OneWay, TargetNullValue=Ready, FallbackValue=Status: Ready, StringFormat={}Status: {0}}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding IsAttachedToWindow, Mode=OneWay, FallbackValue=Attached: False, StringFormat={}Attached: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LastDragAttachStatus, Mode=OneWay, TargetNullValue=Ready, FallbackValue=Drag attach: Ready, StringFormat={}Drag attach: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding AttachmentSide, Mode=OneWay, TargetNullValue=(none), FallbackValue=Attach side: (none), StringFormat={}Attach side: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding AttachmentStatus, Mode=OneWay, TargetNullValue=Not attached, FallbackValue=Attach status: Not attached, StringFormat={}Attach status: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding IsHiddenBecauseTargetMinimized, Mode=OneWay, FallbackValue=Hidden by target minimize: False, StringFormat={}Hidden by target minimize: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LastFollowUpdateText, Mode=OneWay, TargetNullValue=None, FallbackValue=Follow: None, StringFormat={}Follow: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Status}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding AttachmentError, Mode=OneWay, TargetNullValue=None, FallbackValue=Attach error: None, StringFormat={}Attach error: {0}}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsKeyTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="No key details yet — pin something you always want in view for this window.">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource EmptyStateTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PinnedItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PinnedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="KeyCard"
                                                Margin="0,0,0,6"
                                                Padding="9,11"
                                                Background="{DynamicResource Surface.Raised}"
                                                BorderBrush="{DynamicResource Border.Faint}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="4"
                                                            Height="18"
                                                            Background="{DynamicResource Accent}"
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="9,0,8,0"
                                                               Text="{Binding Text}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel x:Name="PinnedReorder"
                                                            Grid.Column="1"
                                                            Opacity="0"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,2,0">
                                                    <Button Style="{StaticResource ReorderButtonStyle}"
                                                            Command="{Binding DataContext.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Move up" AutomationProperties.Name="Move up">
                                                        <Path Width="10" Height="6" Data="M 1 5 L 5 1 L 9 5" Fill="Transparent" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" />
                                                    </Button>
                                                    <Button Style="{StaticResource ReorderButtonStyle}"
                                                            Command="{Binding DataContext.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Move down" AutomationProperties.Name="Move down">
                                                        <Path Width="10" Height="6" Data="M 1 1 L 5 5 L 9 1" Fill="Transparent" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" />
                                                    </Button>
                                                </StackPanel>
                                                <Button x:Name="DeletePinnedButton"
                                                        Grid.Column="2"
                                                        Style="{StaticResource DeleteItemActionButtonStyle}"
                                                    Command="{Binding DataContext.DeletePinnedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                        ToolTip="Delete">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Data="M 3 5 H 11 M 5 5 V 3.5 H 9 V 5 M 4 5 L 4.6 13 H 9.4 L 10 5 M 6 7 V 11 M 8 7 V 11"
                                                          Fill="Transparent"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeThickness="1.3" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="KeyCard" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="KeyCard" Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
                                                <Setter TargetName="DeletePinnedButton" Property="Opacity" Value="1" />
                                                <Setter TargetName="PinnedReorder" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsTodoTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="No to-dos yet — add one above and check it off when it's done.">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource EmptyStateTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TodoItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TodoItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TodoRow"
                                                Margin="0,0,0,6"
                                                Padding="8,9"
                                                Background="Transparent"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Width="22"
                                                          Height="22"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Toggle todo" AutomationProperties.Name="Toggle to-do done">
                                                    <CheckBox.Template>
                                                        <ControlTemplate TargetType="{x:Type CheckBox}">
                                                            <Grid Width="22"
                                                                  Height="22"
                                                                  Background="Transparent">
                                                                <Ellipse x:Name="TodoCircle"
                                                                         Width="17"
                                                                         Height="17"
                                                                         Stroke="{DynamicResource Text.Muted}"
                                                                         StrokeThickness="1.6"
                                                                         Fill="Transparent"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                                                <Path x:Name="TodoCheck"
                                                                      Data="M 5 11 L 9 15 L 16 7"
                                                                      Stroke="{DynamicResource Accent}"
                                                                      StrokeThickness="2"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      Visibility="Collapsed" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="TodoCircle" Property="Stroke" Value="{DynamicResource Accent}" />
                                                                    <Setter TargetName="TodoCheck" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </CheckBox.Template>
                                                </CheckBox>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Margin="8,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel x:Name="TodoReorder"
                                                            Grid.Column="2"
                                                            Opacity="0"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,2,0">
                                                    <Button Style="{StaticResource ReorderButtonStyle}"
                                                            Command="{Binding DataContext.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Move up" AutomationProperties.Name="Move up">
                                                        <Path Width="10" Height="6" Data="M 1 5 L 5 1 L 9 5" Fill="Transparent" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" />
                                                    </Button>
                                                    <Button Style="{StaticResource ReorderButtonStyle}"
                                                            Command="{Binding DataContext.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Move down" AutomationProperties.Name="Move down">
                                                        <Path Width="10" Height="6" Data="M 1 1 L 5 5 L 9 1" Fill="Transparent" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" />
                                                    </Button>
                                                </StackPanel>
                                                <Button x:Name="DeleteTodoButton"
                                                        Grid.Column="3"
                                                        Style="{StaticResource DeleteItemActionButtonStyle}"
                                                        Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Delete">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Data="M 3 5 H 11 M 5 5 V 3.5 H 9 V 5 M 4 5 L 4.6 13 H 9.4 L 10 5 M 6 7 V 11 M 8 7 V 11"
                                                          Fill="Transparent"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeThickness="1.3" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="TodoRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TodoRow" Property="Background" Value="{DynamicResource Surface.Raised}" />
                                                <Setter TargetName="DeleteTodoButton" Property="Opacity" Value="1" />
                                                <Setter TargetName="TodoReorder" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsCommandsTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="No commands yet — save one and copy it with a single click.">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource EmptyStateTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CommandItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding CommandItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="CommandCard"
                                                    Margin="0,0,0,6"
                                                    Padding="9,9,9,11"
                                                    Background="{DynamicResource Surface.Code}"
                                                    BorderBrush="{DynamicResource Border.Faint}"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="3"
                                                            Background="{DynamicResource Accent}"
                                                            CornerRadius="3"
                                                            Opacity="0.6"
                                                            Margin="0,0,9,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Text}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Text.Code}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <Button x:Name="CopyCommandButton"
                                                            Grid.Column="2"
                                                            Style="{StaticResource ItemActionButtonStyle}"
                                                            Command="{Binding DataContext.CopyCommandItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Copy" AutomationProperties.Name="Copy command">
                                                        <Grid Width="14"
                                                              Height="14">
                                                            <Rectangle Width="9"
                                                                       Height="9"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Bottom"
                                                                       Fill="Transparent"
                                                                       RadiusX="1.5"
                                                                       RadiusY="1.5"
                                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       StrokeThickness="1.3" />
                                                            <Rectangle Width="9"
                                                                       Height="9"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Top"
                                                                       Fill="Transparent"
                                                                       RadiusX="1.5"
                                                                       RadiusY="1.5"
                                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       StrokeThickness="1.3" />
                                                        </Grid>
                                                    </Button>
                                                    <StackPanel x:Name="CommandReorder"
                                                                Grid.Column="3"
                                                                Opacity="0"
                                                                VerticalAlignment="Center"
                                                                Margin="3,0,2,0">
                                                        <Button Style="{StaticResource ReorderButtonStyle}"
                                                                Command="{Binding DataContext.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Move up" AutomationProperties.Name="Move up">
                                                            <Path Width="10" Height="6" Data="M 1 5 L 5 1 L 9 5" Fill="Transparent" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" />
                                                        </Button>
                                                        <Button Style="{StaticResource ReorderButtonStyle}"
                                                                Command="{Binding DataContext.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Move down" AutomationProperties.Name="Move down">
                                                            <Path Width="10" Height="6" Data="M 1 1 L 5 5 L 9 1" Fill="Transparent" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" />
                                                        </Button>
                                                    </StackPanel>
                                                    <Button x:Name="DeleteCommandButton"
                                                            Grid.Column="4"
                                                            Style="{StaticResource DeleteItemActionButtonStyle}"
                                                            Command="{Binding DataContext.DeleteCommandItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Delete"
                                                            Margin="3,0,0,0">
                                                        <Path Width="14"
                                                              Height="14"
                                                              Data="M 3 5 H 11 M 5 5 V 3.5 H 9 V 5 M 4 5 L 4.6 13 H 9.4 L 10 5 M 6 7 V 11 M 8 7 V 11"
                                                              Fill="Transparent"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeThickness="1.3" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="CommandCard" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CommandCard" Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
                                                    <Setter TargetName="CopyCommandButton" Property="Opacity" Value="1" />
                                                    <Setter TargetName="DeleteCommandButton" Property="Opacity" Value="1" />
                                                    <Setter TargetName="CommandReorder" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsNotesTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="No notes yet — jot anything here; it stays on this device.">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource EmptyStateTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoteItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding NoteItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="NoteCard"
                                                Margin="0,0,0,6"
                                                Padding="10,11"
                                                Background="{DynamicResource Surface.Raised}"
                                                BorderBrush="{DynamicResource Border.Faint}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Command="{Binding DataContext.ToggleNoteExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch">
                                                        <TextBlock Text="{Binding Text}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   FontSize="13"
                                                                   MaxHeight="56"
                                                                   VerticalAlignment="Top"
                                                                   Margin="0,0,8,0" />
                                                    </Button>
                                                    <StackPanel x:Name="NoteReorder"
                                                                Grid.Column="1"
                                                                Opacity="0"
                                                                VerticalAlignment="Top"
                                                                Margin="0,1,2,0">
                                                        <Button Style="{StaticResource ReorderButtonStyle}"
                                                                Command="{Binding DataContext.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Move up" AutomationProperties.Name="Move up">
                                                            <Path Width="10" Height="6" Data="M 1 5 L 5 1 L 9 5" Fill="Transparent" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" />
                                                        </Button>
                                                        <Button Style="{StaticResource ReorderButtonStyle}"
                                                                Command="{Binding DataContext.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Move down" AutomationProperties.Name="Move down">
                                                            <Path Width="10" Height="6" Data="M 1 1 L 5 5 L 9 1" Fill="Transparent" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" />
                                                        </Button>
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.ToggleNoteExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="23"
                                                            Height="23"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource Text.Faint}"
                                                            ToolTip="Expand note" AutomationProperties.Name="Expand note"
                                                            VerticalAlignment="Top">
                                                        <Path x:Name="NoteExpandChevron"
                                                              Width="11"
                                                              Height="7"
                                                              Data="M 1 1 L 5.5 5.5 L 10 1"
                                                              Fill="Transparent"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeThickness="1.5" />
                                                    </Button>
                                                    <Button x:Name="DeleteNoteButton"
                                                            Grid.Column="3"
                                                            Style="{StaticResource DeleteItemActionButtonStyle}"
                                                            Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Delete"
                                                            VerticalAlignment="Top"
                                                            Margin="4,0,0,0">
                                                        <Path Width="14"
                                                              Height="14"
                                                              Data="M 3 5 H 11 M 5 5 V 3.5 H 9 V 5 M 4 5 L 4.6 13 H 9.4 L 10 5 M 6 7 V 11 M 8 7 V 11"
                                                              Fill="Transparent"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeThickness="1.3" />
                                                    </Button>
                                                </Grid>
                                                <Grid x:Name="NoteExpandedPanel"
                                                      Grid.Row="1"
                                                      Margin="0,10,0,0"
                                                      Visibility="Collapsed">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto"
                                                             MinHeight="90"
                                                             MaxHeight="180"
                                                             FontSize="13">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Escape"
                                                                        Command="{Binding DataContext.ToggleNoteExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <StackPanel Grid.Row="1"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                Margin="0,8,0,0">
                                                        <Button Command="{Binding DataContext.CopyNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Copy"
                                                                Padding="7,3"
                                                                FontSize="11"
                                                                ToolTip="Copy note" />
                                                        <Button Command="{Binding DataContext.SaveNoteEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Save"
                                                                Padding="7,3"
                                                                FontSize="11"
                                                                Margin="6,0,0,0"
                                                                ToolTip="Save note edit" />
                                                        <Button Command="{Binding DataContext.ToggleNoteExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Close"
                                                                Padding="7,3"
                                                                FontSize="11"
                                                                Margin="6,0,0,0"
                                                                ToolTip="Close note" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="NoteCard" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NoteCard" Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
                                                <Setter TargetName="DeleteNoteButton" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger SourceName="NoteCard" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NoteReorder" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="NoteExpandedPanel" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="NoteExpandChevron" Property="Data" Value="M 1 5.5 L 5.5 1 L 10 5.5" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Border Grid.Row="4"
                        Margin="0,9,0,0"
                        Padding="0,9,0,0"
                        BorderBrush="{DynamicResource Border.Hairline}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="{Binding PinnedItems.Count, Mode=OneWay, StringFormat={}{0} key details}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="{Binding TodoSummary, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTodoTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="{Binding CommandItems.Count, Mode=OneWay, StringFormat={}{0} commands}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCommandsTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="{Binding NoteItems.Count, Mode=OneWay, StringFormat={}{0} notes}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNotesTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="10,0,0,0"
                                       Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="{Binding CopyToastText, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowCopyToast}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11">
                                <Run Text="{Binding CurrentSessionDisplayName, Mode=OneWay}" />
                                <Run Text=" &#x00B7; " />
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentSessionNamed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Width="5"
                                    Height="5"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{DynamicResource Text.Faint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAttachedToWindow}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Status.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
                                        <Setter Property="Text" Value="not attached" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAttachedToWindow}" Value="True">
                                                <Setter Property="Text" Value="attached" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
