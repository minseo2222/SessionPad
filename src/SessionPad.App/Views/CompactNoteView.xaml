<UserControl x:Class="SessionPad.App.Views.CompactNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="340">
    <UserControl.Resources>
        <Style x:Key="ItemActionButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.78" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteItemActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ItemActionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
                    <Setter Property="Foreground" Value="#C0453F" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Surface.Base}"
            BorderBrush="{DynamicResource Border.Hairline}"
            BorderThickness="1"
            CornerRadius="11">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              ShadowDepth="1"
                              Opacity="0.10"
                              Color="#282820" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Spine.Neutral}">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{DynamicResource Spine.Neutral}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentSessionNamed}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrentSessionPinned}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Grid Grid.Column="1"
                  Margin="11,11,13,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="0,2"
                            Cursor="SizeAll"
                            ToolTip="Drag near a window to attach"
                            MouseLeftButtonDown="OnDragAttachMouseLeftButtonDown">
                        <TextBlock Text="Drag"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text.Faint}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               Text="SESSIONPAD"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Text.Muted}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3"
                               Text="●"
                               FontSize="14"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentSessionPinned}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="4"
                            Command="{Binding ToggleSettingsCommand}"
                            Content="&#x2699;"
                            Width="25"
                            Height="25"
                            Padding="0"
                            Foreground="{DynamicResource Text.Faint}"
                            ToolTip="Settings" />
                    <Button Grid.Column="5"
                            Command="{Binding CollapseCommand}"
                            Content="&#x2212;"
                            Width="25"
                            Height="25"
                            Padding="0"
                            Margin="5,0,0,0"
                            Foreground="{DynamicResource Text.Faint}"
                            ToolTip="Collapse" />
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,0,0,12"
                        BorderBrush="{DynamicResource Border.Hairline}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Button Content="Key"
                                    Command="{Binding SelectNoteTabCommand}"
                                    CommandParameter="Key"
                                    Padding="7,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyTabActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Grid.Row="1" Background="{DynamicResource Accent}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Button Content="Todo"
                                    Command="{Binding SelectNoteTabCommand}"
                                    CommandParameter="Todo"
                                    Padding="7,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTodoTabActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Grid.Row="1" Background="{DynamicResource Accent}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTodoTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Button Content="Commands"
                                    Command="{Binding SelectNoteTabCommand}"
                                    CommandParameter="Commands"
                                    Padding="7,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCommandsTabActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Grid.Row="1" Background="{DynamicResource Accent}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCommandsTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Button Content="Notes"
                                    Command="{Binding SelectNoteTabCommand}"
                                    CommandParameter="Notes"
                                    Padding="7,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNotesTabActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Grid.Row="1" Background="{DynamicResource Accent}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNotesTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      Margin="0,0,0,12">
                    <Border Background="{DynamicResource Surface.Capture}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3,5,3,11">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsKeyTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding AddPinnedCommand}"
                                    Content="+"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource Accent}"
                                    FontSize="15"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewPinnedText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Save a key detail…"
                                     MinHeight="36"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddPinnedCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2"
                                       Text="↵"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,6,0" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource Surface.Capture}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3,5,3,11">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsTodoTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding AddTodoCommand}"
                                    Content="+"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource Accent}"
                                    FontSize="15"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Capture a todo…"
                                     MinHeight="36"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddTodoCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2"
                                       Text="↵"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,6,0" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource Surface.Capture}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3,5,3,11">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsCommandsTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding AddCommandItemCommand}"
                                    Content="&gt;"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource Accent}"
                                    FontSize="15"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewCommandText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Add a command…"
                                     MinHeight="36"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddCommandItemCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2"
                                       Text="↵"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,6,0" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource Surface.Capture}"
                            BorderBrush="{DynamicResource Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3,5,3,11">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsNotesTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding AddNoteCommand}"
                                    Content="+"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource Accent}"
                                    FontSize="15"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Write a note…"
                                     MinHeight="36"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddNoteCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2"
                                       Text="↵"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,6,0" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="This session"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Text.Primary}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewSessionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Rename this session…"
                                             MinHeight="36"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Content="Rename Session"
                                            Command="{Binding RenameSessionCommand}"
                                            Padding="8,4"
                                            VerticalAlignment="Center" />
                                </Grid>
                                <CheckBox Margin="0,8,0,0"
                                          Content="Pin to this app (ignore window title)"
                                          IsChecked="{Binding IsCurrentSessionPinned, Mode=TwoWay}" />

                                <TextBlock Margin="0,14,0,0"
                                           Text="Local Data"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Text.Primary}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Text="{Binding LocalDataPath, Mode=OneWay, FallbackValue=Storage path unavailable, StringFormat={}Path: {0}}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Text.Faint}"
                                           TextWrapping="Wrap"
                                           Text="SessionPad stores user-entered notes locally. It does not use cloud sync, login, telemetry, screen scraping, or terminal scraping." />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Left"
                                            Command="{Binding OpenLocalDataFolderCommand}"
                                            Content="Open Folder"
                                            MinWidth="88"
                                            Padding="8,4" />
                                    <Button DockPanel.Dock="Right"
                                            Command="{Binding DeleteLocalDataCommand}"
                                            Content="Delete All Local Data"
                                            MinWidth="132"
                                            Padding="8,4"
                                            Margin="8,0,0,0" />
                                </DockPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource Status}"
                                           TextWrapping="Wrap"
                                           Text="{Binding LocalDataStatus, Mode=OneWay, TargetNullValue=Ready, FallbackValue=Local data ready, StringFormat={}Status: {0}}" />

                                <CheckBox Margin="0,12,0,0"
                                          Content="Start with Windows"
                                          IsChecked="{Binding StartOnLogin, Mode=TwoWay}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Status}"
                                           TextWrapping="Wrap"
                                           Text="{Binding StartupStatus, Mode=OneWay, FallbackValue=Startup ready, StringFormat={}Startup: {0}}" />
                                <CheckBox Margin="0,8,0,0"
                                          Content="Dark theme"
                                          IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />

                                <Expander Margin="0,12,0,0"
                                          Foreground="{DynamicResource Text.Primary}">
                                    <Expander.Header>
                                        <TextBlock Text="Developer info"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Text.Primary}" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="Current Session"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Text.Primary}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentSessionDisplayName, Mode=OneWay, TargetNullValue=(none), FallbackValue=Name: (none), StringFormat={}Name: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding CurrentSessionKind, Mode=OneWay, TargetNullValue=(none), FallbackValue=Type: (none), StringFormat={}Type: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentSessionId, Mode=OneWay, TargetNullValue=(none), FallbackValue=Session ID: (none), StringFormat={}Session ID: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentNormalizedWindowTitle, Mode=OneWay, TargetNullValue=(none), FallbackValue=Normalized title: (none), StringFormat={}Normalized title: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentSessionMatchKey, Mode=OneWay, TargetNullValue=(none), FallbackValue=Match key: (none), StringFormat={}Match key: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentSessionNoteFile, Mode=OneWay, TargetNullValue=(none), FallbackValue=Note file: (none), StringFormat={}Note file: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Status}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentSessionStatus, Mode=OneWay, TargetNullValue=Ready, FallbackValue=Session status: Ready, StringFormat={}Session status: {0}}" />

                                        <!-- DetectedWindowInfo is read-only debug state. Use TextBlock or Mode=OneWay bindings only. -->
                                        <TextBlock Margin="0,12,0,0"
                                                   Text="Detected Window"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Text.Primary}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.ProcessName, Mode=OneWay, TargetNullValue=(none), FallbackValue=Process: (none), StringFormat={}Process: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LastDetectedWindow.Title, Mode=OneWay, TargetNullValue=(none), FallbackValue=Title: (none), StringFormat={}Title: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.HwndHex, Mode=OneWay, TargetNullValue=(none), FallbackValue=HWND: (none), StringFormat={}HWND: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.ProcessId, Mode=OneWay, TargetNullValue=(none), FallbackValue=Process ID: (none), StringFormat={}Process ID: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LastDetectedWindow.BoundsText, Mode=OneWay, TargetNullValue=(none), FallbackValue=Bounds: (none), StringFormat={}Bounds: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.IsMinimized, Mode=OneWay, TargetNullValue=(none), FallbackValue=Minimized: (none), StringFormat={}Minimized: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.IsVisible, Mode=OneWay, TargetNullValue=(none), FallbackValue=Visible: (none), StringFormat={}Visible: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.IsSessionPadWindow, Mode=OneWay, TargetNullValue=(none), FallbackValue=SessionPad window: (none), StringFormat={}SessionPad window: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding LastDetectedWindow.WindowClass, Mode=OneWay, TargetNullValue=(none), FallbackValue=Class: (none), StringFormat={}Class: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Status}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LastDetectedWindow.Error, Mode=OneWay, TargetNullValue=Ready, FallbackValue=Status: Ready, StringFormat={}Status: {0}}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding IsAttachedToWindow, Mode=OneWay, FallbackValue=Attached: False, StringFormat={}Attached: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LastDragAttachStatus, Mode=OneWay, TargetNullValue=Ready, FallbackValue=Drag attach: Ready, StringFormat={}Drag attach: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding AttachmentSide, Mode=OneWay, TargetNullValue=(none), FallbackValue=Attach side: (none), StringFormat={}Attach side: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding AttachmentStatus, Mode=OneWay, TargetNullValue=Not attached, FallbackValue=Attach status: Not attached, StringFormat={}Attach status: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding IsHiddenBecauseTargetMinimized, Mode=OneWay, FallbackValue=Hidden by target minimize: False, StringFormat={}Hidden by target minimize: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LastFollowUpdateText, Mode=OneWay, TargetNullValue=None, FallbackValue=Follow: None, StringFormat={}Follow: {0}}" />
                                        <TextBlock Foreground="{DynamicResource Status}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding AttachmentError, Mode=OneWay, TargetNullValue=None, FallbackValue=Attach error: None, StringFormat={}Attach error: {0}}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsKeyTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PinnedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="KeyCard"
                                                Margin="0,0,0,6"
                                                Padding="9,11"
                                                Background="{DynamicResource Surface.Raised}"
                                                BorderBrush="{DynamicResource Border.Faint}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="4"
                                                            Height="18"
                                                            Background="{DynamicResource Accent}"
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="9,0,8,0"
                                                               Text="{Binding Text}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Button x:Name="DeletePinnedButton"
                                                        Grid.Column="1"
                                                        Style="{StaticResource DeleteItemActionButtonStyle}"
                                                    Command="{Binding DataContext.DeletePinnedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                        ToolTip="Delete">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Data="M 3 5 H 11 M 5 5 V 3.5 H 9 V 5 M 4 5 L 4.6 13 H 9.4 L 10 5 M 6 7 V 11 M 8 7 V 11"
                                                          Fill="Transparent"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeThickness="1.3" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="KeyCard" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="KeyCard" Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
                                                <Setter TargetName="DeletePinnedButton" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsTodoTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TodoItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TodoRow"
                                                Margin="0,0,0,6"
                                                Padding="8,9"
                                                Background="Transparent"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Width="22"
                                                          Height="22"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Toggle todo">
                                                    <CheckBox.Template>
                                                        <ControlTemplate TargetType="{x:Type CheckBox}">
                                                            <Grid Width="22"
                                                                  Height="22"
                                                                  Background="Transparent">
                                                                <Ellipse x:Name="TodoCircle"
                                                                         Width="17"
                                                                         Height="17"
                                                                         Stroke="{DynamicResource Text.Muted}"
                                                                         StrokeThickness="1.6"
                                                                         Fill="Transparent"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                                                <Path x:Name="TodoCheck"
                                                                      Data="M 5 11 L 9 15 L 16 7"
                                                                      Stroke="{DynamicResource Accent}"
                                                                      StrokeThickness="2"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      Visibility="Collapsed" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="TodoCircle" Property="Stroke" Value="{DynamicResource Accent}" />
                                                                    <Setter TargetName="TodoCheck" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </CheckBox.Template>
                                                </CheckBox>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Margin="8,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button x:Name="DeleteTodoButton"
                                                        Grid.Column="2"
                                                        Style="{StaticResource DeleteItemActionButtonStyle}"
                                                        Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Delete">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Data="M 3 5 H 11 M 5 5 V 3.5 H 9 V 5 M 4 5 L 4.6 13 H 9.4 L 10 5 M 6 7 V 11 M 8 7 V 11"
                                                          Fill="Transparent"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeThickness="1.3" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="TodoRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TodoRow" Property="Background" Value="{DynamicResource Surface.Raised}" />
                                                <Setter TargetName="DeleteTodoButton" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsCommandsTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding CommandItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="CommandCard"
                                                    Margin="0,0,0,6"
                                                    Padding="9,9,9,11"
                                                    Background="{DynamicResource Surface.Code}"
                                                    BorderBrush="{DynamicResource Border.Faint}"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="3"
                                                            Background="{DynamicResource Accent}"
                                                            CornerRadius="3"
                                                            Opacity="0.6"
                                                            Margin="0,0,9,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Text}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Text.Code}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <Button x:Name="CopyCommandButton"
                                                            Grid.Column="2"
                                                            Style="{StaticResource ItemActionButtonStyle}"
                                                            Command="{Binding DataContext.CopyCommandItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Copy">
                                                        <Grid Width="14"
                                                              Height="14">
                                                            <Rectangle Width="9"
                                                                       Height="9"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Bottom"
                                                                       Fill="Transparent"
                                                                       RadiusX="1.5"
                                                                       RadiusY="1.5"
                                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       StrokeThickness="1.3" />
                                                            <Rectangle Width="9"
                                                                       Height="9"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Top"
                                                                       Fill="Transparent"
                                                                       RadiusX="1.5"
                                                                       RadiusY="1.5"
                                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       StrokeThickness="1.3" />
                                                        </Grid>
                                                    </Button>
                                                    <Button x:Name="DeleteCommandButton"
                                                            Grid.Column="3"
                                                            Style="{StaticResource DeleteItemActionButtonStyle}"
                                                            Command="{Binding DataContext.DeleteCommandItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Delete"
                                                            Margin="3,0,0,0">
                                                        <Path Width="14"
                                                              Height="14"
                                                              Data="M 3 5 H 11 M 5 5 V 3.5 H 9 V 5 M 4 5 L 4.6 13 H 9.4 L 10 5 M 6 7 V 11 M 8 7 V 11"
                                                              Fill="Transparent"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeThickness="1.3" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="CommandCard" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CommandCard" Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
                                                    <Setter TargetName="CopyCommandButton" Property="Opacity" Value="1" />
                                                    <Setter TargetName="DeleteCommandButton" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsNotesTabActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding NoteItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="NoteCard"
                                                Margin="0,0,0,6"
                                                Padding="10,11"
                                                Background="{DynamicResource Surface.Raised}"
                                                BorderBrush="{DynamicResource Border.Faint}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Command="{Binding DataContext.ToggleNoteExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch">
                                                        <TextBlock Text="{Binding Text}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   FontSize="13"
                                                                   MaxHeight="56"
                                                                   VerticalAlignment="Top"
                                                                   Margin="0,0,8,0" />
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.ToggleNoteExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="23"
                                                            Height="23"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource Text.Faint}"
                                                            ToolTip="Expand note"
                                                            VerticalAlignment="Top">
                                                        <Path x:Name="NoteExpandChevron"
                                                              Width="11"
                                                              Height="7"
                                                              Data="M 1 1 L 5.5 5.5 L 10 1"
                                                              Fill="Transparent"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeThickness="1.5" />
                                                    </Button>
                                                    <Button x:Name="DeleteNoteButton"
                                                            Grid.Column="2"
                                                            Style="{StaticResource DeleteItemActionButtonStyle}"
                                                            Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Delete"
                                                            VerticalAlignment="Top"
                                                            Margin="4,0,0,0">
                                                        <Path Width="14"
                                                              Height="14"
                                                              Data="M 3 5 H 11 M 5 5 V 3.5 H 9 V 5 M 4 5 L 4.6 13 H 9.4 L 10 5 M 6 7 V 11 M 8 7 V 11"
                                                              Fill="Transparent"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeThickness="1.3" />
                                                    </Button>
                                                </Grid>
                                                <Grid x:Name="NoteExpandedPanel"
                                                      Grid.Row="1"
                                                      Margin="0,10,0,0"
                                                      Visibility="Collapsed">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto"
                                                             MinHeight="90"
                                                             MaxHeight="180"
                                                             FontSize="13" />
                                                    <StackPanel Grid.Row="1"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                Margin="0,8,0,0">
                                                        <Button Command="{Binding DataContext.CopyNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Copy"
                                                                Padding="7,3"
                                                                FontSize="11"
                                                                ToolTip="Copy note" />
                                                        <Button Command="{Binding DataContext.SaveNoteEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Save"
                                                                Padding="7,3"
                                                                FontSize="11"
                                                                Margin="6,0,0,0"
                                                                ToolTip="Save note edit" />
                                                        <Button Command="{Binding DataContext.ToggleNoteExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Close"
                                                                Padding="7,3"
                                                                FontSize="11"
                                                                Margin="6,0,0,0"
                                                                ToolTip="Close note" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="NoteCard" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NoteCard" Property="BorderBrush" Value="{DynamicResource Border.Hairline}" />
                                                <Setter TargetName="DeleteNoteButton" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="NoteExpandedPanel" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="NoteExpandChevron" Property="Data" Value="M 1 5.5 L 5.5 1 L 10 5.5" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Border Grid.Row="4"
                        Margin="0,9,0,0"
                        Padding="0,9,0,0"
                        BorderBrush="{DynamicResource Border.Hairline}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="{Binding PinnedItems.Count, Mode=OneWay, StringFormat={}{0} key details}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="{Binding TodoSummary, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTodoTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="{Binding CommandItems.Count, Mode=OneWay, StringFormat={}{0} commands}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCommandsTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="{Binding NoteItems.Count, Mode=OneWay, StringFormat={}{0} notes}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNotesTabActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="10,0,0,0"
                                       Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="{Binding CopyToastText, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowCopyToast}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11">
                                <Run Text="{Binding CurrentSessionDisplayName, Mode=OneWay}" />
                                <Run Text=" &#x00B7; " />
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentSessionNamed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Visibility="Collapsed">
                                <Run Text="{Binding CurrentSessionDisplayName, Mode=OneWay}" />
                                <Run Text=" · " />
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentSessionNamed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Width="5"
                                    Height="5"
                                    Background="{DynamicResource Status.Success}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0" />
                            <TextBlock Foreground="{DynamicResource Text.Faint}"
                                       FontSize="11"
                                       Text="attached" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
