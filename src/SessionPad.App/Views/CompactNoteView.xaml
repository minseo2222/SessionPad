<UserControl x:Class="SessionPad.App.Views.CompactNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="300">
    <Border Width="300"
            Padding="14"
            Background="#F8FAFC"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="SessionPad"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding CollapseCommand}"
                        Content="Collapse"
                        MinWidth="72"
                        Padding="8,4"
                        HorizontalAlignment="Right" />
            </DockPanel>

            <StackPanel Grid.Row="1">
                <Border Padding="10"
                        Margin="0,0,0,8"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Pinned"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="{Binding PinnedText}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#334155" />
                    </StackPanel>
                </Border>

                <Border Padding="10"
                        Margin="0,0,0,8"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Todo"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <CheckBox Margin="0,6,0,0"
                                  Content="{Binding TodoText}"
                                  IsChecked="False"
                                  Foreground="#334155" />
                    </StackPanel>
                </Border>

                <Border Padding="10"
                        Margin="0,0,0,8"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Commands"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBox Text="{Binding CommandText, Mode=OneWay}"
                                 Margin="0,6,0,0"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="#F1F5F9"
                                 Padding="6"
                                 Foreground="#1E293B" />
                    </StackPanel>
                </Border>

                <Border Padding="10"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Notes"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBox Text="{Binding NotesText, Mode=OneWay}"
                                 Margin="0,6,0,0"
                                 MinHeight="76"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="#F1F5F9"
                                 Padding="6"
                                 Foreground="#1E293B" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
